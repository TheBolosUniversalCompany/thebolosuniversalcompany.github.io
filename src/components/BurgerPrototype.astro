  { key: 'history', first: 'Our History', second: '& Future', panel: true },
  { key: 'investors', first: 'Investors', second: '', href: '/en/investors' },
  { key: 'careers', first: 'Careers', second: '', href: '/en/careers' },
  { key: 'newsroom', first: 'Newsroom', second: '', href: '/en/newsroom' },
